<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_salon" model="ir.module.category">
        <field name="name">Salon</field>
        <field name="description">Manage salon appointments and booking pages.</field>
        <field name="sequence">20</field>
    </record>

    <record id="privilege_salon" model="res.groups.privilege">
        <field name="name">Salon</field>
        <field name="category_id" ref="module_category_salon"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_salon_user" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="privilege_salon"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_salon_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_salon"/>
        <field name="implied_ids" eval="[(4, ref('group_salon_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- Multi-company: users only see appointments of companies they are allowed in -->
    <record id="salon_appointment_company_rule" model="ir.rule">
        <field name="name">Salon Appointment: multi-company</field>
        <field name="model_id" ref="model_salon_appointment"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="salon_appointment_type_company_rule" model="ir.rule">
        <field name="name">Salon Booking Page: multi-company</field>
        <field name="model_id" ref="model_salon_appointment_type"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

</odoo>
