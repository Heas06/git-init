<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_form_salon" model="ir.ui.view">
        <field name="name">hr.employee.form.salon</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salon" name="salon">
                    <group>
                        <field name="is_salon_staff"/>
                        <field name="salon_service_ids" widget="many2many_tags"
                               invisible="not is_salon_staff"/>
                    </group>
                    <div class="text-muted" invisible="not is_salon_staff">
                        Availability comes from this employee's Working Hours
                        (Work Information tab) and time off.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
