<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="salon_booking_page" name="Salon Booking">
        <t t-call="website.layout">
            <t t-set="additional_title" t-value="atype.name"/>
            <div id="wrap">
                <div class="container py-5 o_salon_booking"
                     t-att-data-slug="atype.slug"
                     t-att-data-min-date="min_date"
                     t-att-data-max-date="max_date">

                    <div class="text-center mb-5">
                        <h1 t-out="atype.company_id.name"/>
                        <p class="lead text-muted" t-out="atype.name"/>
                    </div>

                    <div class="o_salon_step" id="o_salon_step_service">
                        <h3 class="mb-3">1. Choose a service</h3>
                        <div class="row g-3">
                            <t t-foreach="services" t-as="service">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="card o_salon_card o_salon_service_card h-100"
                                         t-att-data-service-id="service.id"
                                         role="button" tabindex="0">
                                        <div class="card-body">
                                            <h5 class="card-title" t-out="service.name"/>
                                            <p class="card-text text-muted mb-1">
                                                <t t-out="service.salon_duration"/> h
                                            </p>
                                            <p class="card-text fw-bold">
                                                <span t-field="service.list_price"
                                                      t-options="{'widget': 'monetary', 'display_currency': service.currency_id}"/>
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="o_salon_step d-none" id="o_salon_step_staff">
                        <h3 class="mb-3 mt-5">2. Choose a staff member</h3>
                        <div class="row g-3">
                            <div class="col-12 col-md-6 col-lg-4">
                                <div class="card o_salon_card o_salon_staff_card h-100"
                                     data-employee-id="" role="button" tabindex="0">
                                    <div class="card-body">
                                        <h5 class="card-title">Any available</h5>
                                    </div>
                                </div>
                            </div>
                            <t t-foreach="employees" t-as="employee">
                                <div class="col-12 col-md-6 col-lg-4">
                                    <div class="card o_salon_card o_salon_staff_card h-100"
                                         t-att-data-employee-id="employee.id"
                                         t-att-data-service-ids="','.join(str(i) for i in employee.salon_service_ids.ids)"
                                         role="button" tabindex="0">
                                        <div class="card-body">
                                            <h5 class="card-title" t-out="employee.name"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <div class="o_salon_step d-none" id="o_salon_step_date">
                        <h3 class="mb-3 mt-5">3. Pick a date and time</h3>
                        <input type="date" id="o_salon_date" class="form-control mb-3" style="max-width: 220px;"/>
                        <div id="o_salon_slots" class="d-flex flex-wrap gap-2"/>
                        <p id="o_salon_slots_empty" class="text-muted d-none">
                            No times available this day. Try another date.
                        </p>
                    </div>

                    <div class="o_salon_step d-none" id="o_salon_step_contact">
                        <h3 class="mb-3 mt-5">4. Your details</h3>
                        <form id="o_salon_form" class="row g-3" style="max-width: 480px;">
                            <div class="col-12">
                                <label class="form-label">Full name *</label>
                                <input type="text" name="name" class="form-control" required="required"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Phone</label>
                                <input type="tel" name="phone" class="form-control"/>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Email</label>
                                <input type="email" name="email" class="form-control"/>
                            </div>
                            <div class="o_salon_hp" aria-hidden="true">
                                <label for="o_salon_hp_input">Leave this field blank</label>
                                <input id="o_salon_hp_input" type="text" name="hp" tabindex="-1" autocomplete="off"/>
                            </div>
                            <p class="text-muted small mb-0">At least a phone number or an email is required.</p>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary" id="o_salon_submit">
                                    Confirm appointment
                                </button>
                            </div>
                            <div class="col-12">
                                <p id="o_salon_error" class="text-danger d-none"/>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="salon_booking_status" name="Salon Booking Status">
        <t t-call="website.layout">
            <t t-set="additional_title">Your appointment</t>
            <div id="wrap">
                <div class="container py-5" style="max-width: 560px;">
                    <div class="card">
                        <div class="card-body">
                            <h3 class="card-title mb-3">
                                <t t-if="appointment.state == 'cancelled'">Appointment cancelled</t>
                                <t t-elif="appointment.state == 'no_show'">Marked as no-show</t>
                                <t t-else="">You're booked!</t>
                            </h3>
                            <p><strong>Reference:</strong> <t t-out="appointment.name"/></p>
                            <p><strong>Service:</strong> <t t-out="appointment.service_id.name"/></p>
                            <p><strong>With:</strong> <t t-out="appointment.employee_id.name"/></p>
                            <p><strong>When:</strong> <t t-out="appointment.start_display"/></p>
                            <p class="mb-0"><strong>Status:</strong> <span t-out="appointment.state"/></p>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

</odoo>
