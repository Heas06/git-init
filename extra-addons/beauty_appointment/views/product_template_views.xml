<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_salon" model="ir.ui.view">
        <field name="name">product.template.form.salon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Salon Service" name="salon">
                    <group>
                        <field name="salon_service"/>
                    </group>
                    <group invisible="not salon_service">
                        <field name="salon_duration" widget="float_time"/>
                        <field name="salon_buffer" widget="float_time"/>
                        <field name="salon_employee_ids" widget="many2many_tags"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
